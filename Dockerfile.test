# Runs the full CI gate (type-check + tests + build) in the same Linux/Node 22
# image the GitHub runner uses. The point is to catch what a Windows dev box
# hides: platform-specific optional deps (rolldown/lightningcss/sharp native
# binaries), case-sensitive import paths, and CRLF-sensitive assertions.
#
#   npm run test:docker
#
# The GitHub Packages token is passed as a BuildKit secret, never an ARG or ENV
# — a build arg would be baked into the image history.
FROM node:22-bookworm-slim

WORKDIR /app

# Manifest first so the (slow) install layer caches across source edits.
# .npmrc points @tracht-digital-solutions at GitHub Packages and reads
# ${NPM_TOKEN} from the environment.
COPY package.json .npmrc ./

# --no-package-lock: the committed lockfile is generated on Windows and pins
# win32-only native binaries; npm ci would install the wrong ones here.
# See AGENTS.md / npm/cli#4828.
RUN --mount=type=secret,id=npm_token \
    NPM_TOKEN="$(cat /run/secrets/npm_token)" npm install --no-package-lock

COPY . .

# Same three steps as _build.yml, in the same order.
CMD ["sh", "-c", "npm run type-check && npm run test:run && npm run build"]
