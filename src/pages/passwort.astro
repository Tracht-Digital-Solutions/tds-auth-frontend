---
import Layout from "~/layouts/Layout.astro";
import PasswordChangeForm from "~/components/PasswordChangeForm.tsx";
---

<Layout title="Passwort ändern — Tracht Digital Solutions">
  <h1>Passwort ändern</h1>
  <p class="auth-card__lede">
    Bitte vergeben Sie ein neues Passwort (mindestens 12 Zeichen). Danach werden
    Sie zu Ihrem Ziel weitergeleitet.
  </p>
  <PasswordChangeForm client:load />
</Layout>
