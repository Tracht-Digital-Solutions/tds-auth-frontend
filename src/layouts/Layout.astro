---
// Font faces must be imported here (not via @import in global.css):
// @tailwindcss/postcss inlines CSS @imports without rebasing their relative
// url(./files/*.woff2) refs, so Vite never emits the fonts otherwise.
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "@fontsource/lato/900.css";
// Plus Jakarta Sans, not Geist: the canonical body face for every TDS surface.
// This site shipped Geist and re-declared --font-body locally to reach it, so
// the login was the one product rendering in a different face from the panels,
// the portal, the blog and the landingpage. JetBrains Mono is deliberately NOT
// imported — `--font-mono` has no call site in this repo, and an unused font
// package is pure payload.
import "@fontsource-variable/plus-jakarta-sans";
import "~/styles/global.css";
import { ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import { ConsentBanner, ConsentLink } from "@tracht-digital-solutions/tds-shared/consent";
import LoginArtwork from "~/components/LoginArtwork.tsx";
import { legalLinks, site } from "~/lib/site";

interface Props {
  title: string;
  description?: string;
  /**
   * `"login"` is the split shell every visitor-facing page uses: form left,
   * generated artwork right.
   *
   * `"plain"` is a single centred column for the operator pages. The setup
   * wizard is a wide diagnostic with a JSON preview and the login column is
   * 384px wide — it was unreadable in it. The two share this `<head>`
   * deliberately: the theme bootstrap, the Fontsource imports and the
   * stylesheet order are the half that must never fork.
   */
  variant?: "login" | "plain";
}

const { title, description = site.description, variant = "login" } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050f68" />
    {/* Private surface — never index the login. */}
    <meta name="robots" content="noindex,nofollow" />
    {/* The brand mark shared by every TDS property. It used to be a hand-drawn
        padlock SVG unique to this site — the login is the one surface a user
        reaches from all the others, so an odd tab icon here read as a different
        (or spoofed) service. Keep it byte-identical to the landingpage's. */}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />

    {/* No-flash theme bootstrap — same key as every other TDS frontend so the
        light/dark choice carries across properties. Raw body; do not wrap. */}
    <script is:inline>
      document.documentElement.classList.add("js");
      (function () {
        try {
          var saved = localStorage.getItem("tds-theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.setAttribute("data-theme", saved);
            return;
          }
        } catch (e) {}
        var dark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
      })();
    </script>

    <link rel="preconnect" href="https://api.tracht-digital.de" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    {/*
      Split shell: the form on the left, a freshly generated composition on the
      right. The form comes FIRST in the DOM on purpose — on a wide screen the
      artwork sits to its right, and on a narrow one CSS grid lifts the artwork
      above it, but keyboard and screen-reader order stay "sign in, then
      decoration" either way.
    */}
    {variant === "plain" ? (
      <main class="tds-shell auth-plain" data-surface="panel">
        <slot />
      </main>
    ) : (
    <main class="auth-page">
      {/* `.tds-wash` gives the form half the warm brand ground the rest
          of the brand now uses — the soft fields sit at its outer edges,
          well away from the field labels, and turn themselves down on a
          phone and in dark mode. Without it this half was flat
          `--color-paper`, which read as sterile next to the deliberately
          rich artwork panel. */}
      <div class="auth-panel tds-wash">
        <div class="auth-panel__inner">
          <header class="auth-brand">
            <strong class="brand-wordmark text-lg"
              >Tracht<span class="accent-italic"> Solutions</span></strong
            >
            <div class="auth-brand__toolbar">
              <ThemeToggle client:idle />
            </div>
          </header>
          {/* The three-part brand accent, sized small — the login is a
              single card of content, so this is its only ornament. */}
          <span aria-hidden="true" class="tds-brandbar tds-brandbar--sm auth-brand__bar"></span>
          <slot />
        </div>
      </div>

      {/* Decorative only — the island renders nothing until it has generated a
          composition, and the panel's own gradient covers that first frame. */}
      <div class="auth-art" aria-hidden="true">
        <LoginArtwork client:load />
      </div>
    </main>
    )}

    {/*
      The legal row. This surface carried none — see `legalLinks` for why that
      mattered — and the consent entry point belongs beside them rather than
      buried, because withdrawing has to be as easy as giving (Art. 7 Abs. 3
      DSGVO).
    */}
    <nav class="auth-legal" aria-label="Rechtliches">
      <a href={legalLinks.impressum}>Impressum</a>
      <a href={legalLinks.datenschutz}>Datenschutz</a>
      <ConsentLink client:idle lang="de" />
    </nav>

    {/*
      `variant="panel"` is the wording, not a different mechanism: this surface
      DOES set a cookie — the session one, on login — and saying "no cookies"
      here would be false. No `categories`, because there is nothing optional
      to decide about; the banner states the fact and offers one
      acknowledgement.

      `lang` and `privacyUrl` are passed explicitly. They were not, so the
      notice took its defaults, and the privacy link went to a hard-coded
      absolute URL that nothing here could see or check.
    */}
    <ConsentBanner
      client:idle
      lang="de"
      variant="panel"
      privacyUrl={legalLinks.datenschutz}
      imprintUrl={legalLinks.impressum}
    />
  </body>
</html>
