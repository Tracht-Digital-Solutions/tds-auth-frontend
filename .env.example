# Base URL of tds-auth-api (through the gateway's /auth prefix). The login site
# POSTs /login, reads /me, PUTs /password against it. Prod default is baked in
# when unset; for local dev point it at the local stack.
PUBLIC_AUTH_API_URL=https://api.tracht-digital.de/auth
# Local dev example:
# PUBLIC_AUTH_API_URL=http://localhost:8000/auth
